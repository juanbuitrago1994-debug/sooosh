# Copia este archivo a .env.local y ajústalo. Solo se usa Ollama local (costo cero).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Modelo de la versión ATS del CV (lectura profunda y resumen). Medido: gemma4:e4b la lee en ≈ 50 s (qwen2.5:7b-instruct, ≈ 135 s). Si no se define, se usa OLLAMA_MODEL.
OLLAMA_ATS_MODEL=gemma4:e4b
# Modelo de embeddings para comparar el CV con la oferta (por defecto se usa bge-m3 si está instalado).
# OLLAMA_EMBED_MODEL=bge-m3

# Supabase (solo datos; plan gratuito). Cópialos desde el dashboard del proyecto y pégalos en .env.local, nunca aquí.
# Project Settings → API Keys → clave secreta (sb_secret_…)
# SUPABASE_SECRET_KEY=
# Connect → Transaction pooler (puerto 6543). Sin corchetes y con la contraseña de la base:
# DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-…pooler.supabase.com:6543/postgres

# Clave del panel de ofertas (/admin/ofertas): inventa una de 12+ caracteres.
# ADMIN_TOKEN=

# Cuentas (fase 1). La clave publishable es segura de exponer: Project Settings → API Keys → «publishable».
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Firma la cookie de dispositivo. Genera una: openssl rand -hex 32  (si la cambias, todas las sesiones piden entrar de nuevo)
# AUTH_DEVICE_SECRET=

# Clave para que los scripts de banco de pruebas llamen a /api/* sin sesión (cabecera x-sooosh-bench). Solo local; NO la definas en producción. Genera una: openssl rand -hex 24
# BENCH_KEY=
