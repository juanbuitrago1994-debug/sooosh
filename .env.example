# Copia este archivo a .env.local y ajústalo. Solo se usa Ollama local (costo cero).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Modelo de embeddings para comparar el CV con la oferta (por defecto se usa bge-m3 si está instalado).
# OLLAMA_EMBED_MODEL=bge-m3

# Supabase (solo datos; plan gratuito). Cópialos desde el dashboard del proyecto y pégalos en .env.local, nunca aquí.
# Project Settings → API Keys → clave secreta (sb_secret_…)
# SUPABASE_SECRET_KEY=
# Connect → Transaction pooler (puerto 6543). Sin corchetes y con la contraseña de la base:
# DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-…pooler.supabase.com:6543/postgres

# Clave del panel de ofertas (/admin/ofertas): inventa una de 12+ caracteres.
# ADMIN_TOKEN=
